<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>FokySdk.EFCore.Migrations</PackageId>
        <Version>1.0.0</Version>
        <Authors>fokypoky</Authors>
        <Description>-</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/fokypoky/FokySdk.EFCore.Migrations</PackageProjectUrl>
        <RepositoryUrl>https://github.com/fokypoky/FokySdk.EFCore.Migrations</RepositoryUrl>
        <PackageTags>efcore; postgresql; migration;</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>

</Project>
